{
  "name": "insider",
  "version": "0.1.0",
  "private": true,
  "description": "INSIDER: a real-time front-running game on Solana with a TEE-sealed dark mempool, built on MagicBlock Ephemeral Rollups, VRF and Private ER.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "lint": "pnpm --filter app lint",
    "format": "prettier --write README.md \"docs/*.md\" package.json pnpm-workspace.yaml \".github/workflows/*.yml\" \"app/src\" \"app/*.{json,ts,mjs}\" \"bots/**/*.{ts,json}\" \"scripts/**/*.{ts,json}\" \"sdk/**/*.{ts,json}\"",
    "format:check": "prettier --check README.md \"docs/*.md\" package.json pnpm-workspace.yaml \".github/workflows/*.yml\" \"app/src\" \"app/*.{json,ts,mjs}\" \"bots/**/*.{ts,json}\" \"scripts/**/*.{ts,json}\" \"sdk/**/*.{ts,json}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "bots": "pnpm --filter bots dev",
    "program:check": "cd programs && cargo check -p insider",
    "program:test": "cd programs && cargo test -p insider",
    "program:build": "cd programs && cargo build-sbf --manifest-path insider/Cargo.toml",
    "program:idl": "cd programs && anchor idl build -p insider -o idl/insider.json",
    "program:deploy": "solana program deploy programs/target/deploy/insider.so --program-id .keys/insider-v1-program-keypair.json --keypair .keys/deployer.json --url devnet",
    "proofs": "tsx scripts/src/build-proof-index.ts",
    "gates": "tsx scripts/src/gates/run.ts",
    "setup-table": "tsx scripts/src/setup-table.ts",
    "vertical-slice": "tsx scripts/src/vertical-slice.ts",
    "simulate-round": "tsx scripts/src/simulate-round.ts",
    "privacy-test": "tsx scripts/src/privacy-test.ts",
    "go-live": "tsx scripts/src/go-live.ts",
    "desk-demo": "tsx scripts/src/desk-demo.ts",
    "run-table": "tsx scripts/src/vertical-slice.ts --forever",
    "fund": "pnpm --filter bots fund",
    "operator": "pnpm --filter bots operator"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
