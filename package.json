{
  "name": "insider",
  "version": "0.1.0",
  "private": true,
  "description": "Insider: a real-time social-deduction trading game on Solana, built on MagicBlock Ephemeral Rollups.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "lint": "pnpm --filter app lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter tests test",
    "bots": "pnpm --filter bots dev",
    "program:build": "cargo build-sbf --manifest-path programs/insider/Cargo.toml",
    "program:idl": "anchor idl build -o idl/insider.json",
    "program:check": "cargo check -p insider",
    "program:test": "cargo test -p insider",
    "program:deploy": "solana program deploy target/deploy/insider.so --program-id .keys/insider-program-keypair.json --keypair .keys/deployer.json --url devnet",
    "validator:local": "ephemeral-validator"
  },
  "devDependencies": {
    "@magicblock-labs/ephemeral-validator": "^2.0.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
